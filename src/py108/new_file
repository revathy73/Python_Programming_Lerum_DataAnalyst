import cv2

def process_video(video_path):
    """
    Reads a video file frame-by-frame and processes each frame.
    :param video_path: Path to the video file or integer (0 for webcam)
    """
    # Open the video file or webcam
    cap = cv2.VideoCapture(video_path)

    if not cap.isOpened():
        print(f"Error: Cannot open video source '{video_path}'")
        return

    # Get video properties
    fps = cap.get(cv2.CAP_PROP_FPS)
    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
    print(f"Video properties: {width}x{height} @ {fps:.2f} FPS")

    while True:
        ret, frame = cap.read()

        if not ret:
            print("End of video or cannot read frame.")
            break

        # Example processing: convert to grayscale
        gray_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

        # Example processing: draw a rectangle
        cv2.rectangle(gray_frame, (50, 50), (200, 200), (255, 255, 255), 2)

        # Display original and processed frames
        cv2.imshow("Original Frame", frame)
        cv2.imshow("Processed Frame", gray_frame)

        # Press 'q' to quit early
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    # Release resources
    cap.release()
    cv2.destroyAllWindows()


if __name__ == "__main__":
    # Change to 0 for webcam, or provide a video file path
    process_video("sample_video.mp4")
